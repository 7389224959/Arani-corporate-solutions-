# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Set these in your platform environment settings or .env file
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# META / WHATSAPP & INSTAGRAM CHATBOT CONFIGURATION
# Set these in your platform environment settings or .env file
META_VERIFY_TOKEN="aranii_meta_webhook_verify_token_2026"
META_APP_SECRET="your-meta-app-secret-for-sha256-verification"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-cloud-api-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-system-user-access-token"
INSTAGRAM_PAGE_ID="your-instagram-business-account-id"
INSTAGRAM_ACCESS_TOKEN="your-instagram-graph-api-access-token"
CHATBOT_AI_ENABLED="true"

# META PIXEL & MEGA JOB DRIVE CONFIGURATION
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"
NEXT_PUBLIC_MEGA_DRIVE_UPI_ID="aranii@icici"
NEXT_PUBLIC_MEGA_DRIVE_UPI_NAME="Aranii Corporate Solutions"
NEXT_PUBLIC_MEGA_DRIVE_FEE="299"
MEGA_DRIVE_ADMIN_SECRET="aranii_admin_secret_2026"

